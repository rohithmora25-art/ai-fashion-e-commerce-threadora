            <select id="aiBudget" class="ai-select">
              <option value="All">All Budgets</option>
              <option value="Under ₹2,000">Under ₹2,000</option>
              <option value="₹2,000 - ₹4,500">₹2,000 – ₹4,500</option>
              <option value="₹4,500+">₹4,500+ Luxury</option>
