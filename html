    const MENS_CATEGORIES = ['All', 'Oversized T-Shirts', 'Graphic T-Shirts', 'Plain T-Shirts', 'Premium Shirts', 'Casual Shirts', 'Formal Shirts', 'Hoodies', 'Oversized Hoodies', 'Zip-Up Hoodies', 'Sweatshirts', 'Crewneck Sweatshirts', 'Jackets', 'Denim Jackets', 'Cargo Pants', 'Joggers', 'Baggy Jeans', 'Slim-Fit Jeans', 'Trousers', 'Polo T-Shirts', 'Co-ord Sets', 'Casual Wear', 'Formal Wear', 'Ethnic Wear'];
    const WOMENS_CATEGORIES = ['All', 'Dresses', 'Maxi Dresses', 'Mini Dresses', 'Casual Tops', 'Crop Tops', 'Oversized T-Shirts', 'Hoodies', 'Sweatshirts', 'Shirts', 'Jeans', 'Wide-Leg Jeans', 'Cargo Pants', 'Leggings', 'Skirts', 'Co-ord Sets', 'Kurtis', 'Ethnic Wear', 'Jackets', 'Cardigans', 'Party Wear'];
    const KIDS_CATEGORIES = ['All', "Boys' T-Shirts", "Boys' Shirts", 'Hoodies', 'Sweatshirts', 'Jeans', "Girls' Dresses", 'Tops', 'Casual Sets', 'Jackets', 'Everyday Wear'];

    const CATEGORY_ALIASES = {
      'Hoodies': ['Hoodies', 'Oversized Hoodies', 'Zip-Up Hoodies'],
      'Sweatshirts': ['Sweatshirts', 'Crewneck Sweatshirts'],
      'Casual Wear': ['Oversized T-Shirts', 'Graphic T-Shirts', 'Plain T-Shirts', 'Casual Shirts', 'Cargo Pants', 'Joggers', 'Baggy Jeans', 'Co-ord Sets'],
      'Formal Wear': ['Formal Shirts', 'Premium Shirts', 'Trousers', 'Formal Wear'],
      'Casual Tops': ['Crop Tops', 'Oversized T-Shirts', 'Shirts'],
      'Jeans': ['Wide-Leg Jeans', 'Baggy Jeans', 'Slim-Fit Jeans', 'Jeans'],
      'Ethnic Wear': ['Ethnic Wear', 'Kurtis'],
      'Party Wear': ['Dresses', 'Maxi Dresses', 'Jackets', 'Premium Shirts'],
      'Everyday Wear': ["Boys' T-Shirts", 'Hoodies', 'Casual Sets', 'Jeans'],
      'Tops': ["Boys' T-Shirts", 'Casual Sets']
    };

    const state = {
      gender: 'All',
      category: 'All',
      ageGroup: 'All Ages',
      size: 'All',
      color: 'All',
      maxPrice: 11000,
      tag: 'All',
      sort: 'featured',
      search: '',
      aiGender: 'Men',
      aiOccasion: 'Casual',
      aiStyle: 'Streetwear',
      aiCategory: 'Any',
      aiBudget: 'All',
      promoApplied: false,
      cart: JSON.parse(localStorage.getItem('threadora_html_cart') || '[]'),
      wishlist: JSON.parse(localStorage.getItem('threadora_html_wish') || '["m-1","w-1"]'),
      qvProduct: null,
      qvSize: '',
      qvColor: '',
      qvQty: 1
    };

    const formatINR = (n) => '₹' + Number(n).toLocaleString('en-IN');

    function saveStorage() {
      localStorage.setItem('threadora_html_cart', JSON.stringify(state.cart));
      localStorage.setItem('threadora_html_wish', JSON.stringify(state.wishlist));
      updateBadges();
    }

    function showToast(msg) {
      const toast = document.getElementById('toastBanner');
      document.getElementById('toastText').textContent = msg;
      toast.classList.remove('hidden');
      clearTimeout(window.__toastTimer);
      window.__toastTimer = setTimeout(() => toast.classList.add('hidden'), 3000);
    }

    function updateBadges() {
      const totalItems = state.cart.reduce((sum, i) => sum + i.quantity, 0);
      document.getElementById('cartBadge').textContent = totalItems;
      document.getElementById('drawerCartCount').textContent = totalItems;
      document.getElementById('wishlistBadge').textContent = state.wishlist.length;
      document.getElementById('drawerWishlistCount').textContent = state.wishlist.length;
    }

    function createProductCardHTML(p) {
      const discount = Math.round(((p.originalPrice - p.price) / p.originalPrice) * 100);
      const isWished = state.wishlist.includes(p.id);
      const swatches = p.colors.map(c => `<span class="swatch-dot" title="${c.name}" style="background:${c.hex}"></span>`).join('');
      return `
        <article class="product-card" data-id="${p.id}">
          <div class="card-media" onclick="openQuickView('${p.id}')">
            <img src="${p.image}" alt="${p.name}" loading="lazy" />
            <div class="card-badges">
              ${p.isNew ? '<span class="badge-new">New</span>' : ''}
              ${p.isTrending ? '<span class="badge-trend">Trending</span>' : ''}
            </div>
            <div class="card-actions-top">
              <button type="button" class="circle-icon ${isWished ? 'active' : ''}" onclick="event.stopPropagation(); toggleWishlist('${p.id}')" aria-label="Wishlist">♥</button>
              <button type="button" class="circle-icon" onclick="event.stopPropagation(); openQuickView('${p.id}')" aria-label="Quick View">👁</button>
            </div>
          </div>
          <div class="card-body">
            <div class="card-meta-row">
              <span class="card-cat">${p.gender} • ${p.category}</span>
              <span class="card-rating">★ ${p.rating} (${p.reviews})</span>
            </div>
            <h3 class="card-title" onclick="openQuickView('${p.id}')">${p.name}</h3>
            <div class="swatch-row">${swatches} <span class="swatch-count">${p.colors.length} Colors</span></div>
            <div class="card-footer">
              <div class="price-row">
                <div>
                  <strong class="price-now">${formatINR(p.price)}</strong>
                  <span class="price-old">${formatINR(p.originalPrice)}</span>
                </div>
                <span class="discount-pill">${discount}% OFF</span>
              </div>
              <button type="button" class="btn-add-bag" onclick="addToCart('${p.id}')">Add to Bag</button>
            </div>
          </div>
        </article>
      `;
    }

    function renderCategoryPills() {
      const container = document.getElementById('categoryPillsContainer');
      const title = document.getElementById('categoryBarTitle');
      let list = ['All', 'Oversized Hoodies', 'Oversized T-Shirts', 'Cargo Pants', 'Baggy Jeans', 'Crewneck Sweatshirts', 'Formal Shirts', 'Jackets', 'Dresses', 'Wide-Leg Jeans', 'Co-ord Sets', 'Kurtis', "Girls' Dresses", 'Casual Sets'];
      if (state.gender === 'Men') {
        list = MENS_CATEGORIES;
        title.textContent = 'Men’s Categories (23 Styles)';
      } else if (state.gender === 'Women') {
        list = WOMENS_CATEGORIES;
        title.textContent = 'Women’s Categories (20 Styles)';
      } else if (state.gender === 'Kids') {
        list = KIDS_CATEGORIES;
        title.textContent = 'Kids’ Categories';
      } else {
        title.textContent = 'Popular Categories';
      }

      container.innerHTML = list.map(cat => `
        <button type="button" class="cat-pill ${state.category === cat ? 'active' : ''}" onclick="selectCategory('${cat.replace(/'/g, "\\'")}')">${cat}</button>
      `).join('');
    }

    function renderCatalog() {
      const kidsBar = document.getElementById('kidsAgeBar');
      kidsBar.classList.toggle('hidden', state.gender !== 'Kids');

      document.getElementById('catalogHeading').textContent = state.gender === 'All' ? 'Curated Collections' : `${state.gender}’s Fashion`;

      let filtered = PRODUCTS.filter(p => {
        if (state.gender !== 'All' && p.gender !== state.gender) return false;
        if (state.gender === 'Kids' && state.ageGroup !== 'All Ages' && p.ageGroup !== state.ageGroup) return false;
        if (state.category !== 'All') {
          const allowed = CATEGORY_ALIASES[state.category] || [state.category];
          if (!allowed.includes(p.category)) return false;
        }
        if (state.size !== 'All' && !p.sizes.includes(state.size)) return false;
        if (state.color !== 'All' && !p.colors.some(c => c.name.toLowerCase().includes(state.color.toLowerCase()))) return false;
        if (p.price > state.maxPrice) return false;
        if (state.tag === 'New' && !p.isNew) return false;
        if (state.tag === 'Trending' && !p.isTrending) return false;
        if (state.tag === 'BestSeller' && !p.isBestSeller) return false;
        if (state.search.trim()) {
          const q = state.search.toLowerCase();
          if (!p.name.toLowerCase().includes(q) && !p.category.toLowerCase().includes(q) && !p.description.toLowerCase().includes(q)) return false;
        }
        return true;
      });

      if (state.sort === 'price-asc') filtered.sort((a, b) => a.price - b.price);
      if (state.sort === 'price-desc') filtered.sort((a, b) => b.price - a.price);
      if (state.sort === 'popularity') filtered.sort((a, b) => b.reviews - a.reviews);
      if (state.sort === 'rating') filtered.sort((a, b) => b.rating - a.rating);

      document.getElementById('catalogCountText').textContent = `Showing ${filtered.length} authentic garments with verified studio photography`;
      const grid = document.getElementById('mainCatalogGrid');
      if (filtered.length === 0) {
        grid.innerHTML = `<div class="empty-state"><h3>No garments matched your filter combination</h3><p>Try widening your price range or resetting filters.</p></div>`;
      } else {
        grid.innerHTML = filtered.map(createProductCardHTML).join('');
      }
    }

    function renderStaticSections() {
      document.getElementById('newArrivalsGrid').innerHTML = PRODUCTS.filter(p => p.isNew).slice(0, 4).map(createProductCardHTML).join('');
      document.getElementById('trendingGrid').innerHTML = PRODUCTS.filter(p => p.isBestSeller).slice(0, 4).map(createProductCardHTML).join('');
    }

    function renderAIStudio() {
      const pool = PRODUCTS.filter(p => p.gender === state.aiGender);
      const scored = pool.map(item => {
        let score = 0;
        if (item.occasions.includes(state.aiOccasion)) score += 4;
        if (item.styles.includes(state.aiStyle)) score += 4;
        if (state.aiCategory !== 'Any' && item.category.toLowerCase().includes(state.aiCategory.toLowerCase())) score += 5;
        if (state.aiBudget === 'Under ₹2,000' && item.price <= 2000) score += 3;
        if (state.aiBudget === '₹2,000 - ₹4,500' && item.price >= 2000 && item.price <= 4500) score += 3;
        if (state.aiBudget === '₹4,500+' && item.price >= 4500) score += 3;
        return { item, score };
      }).sort((a, b) => b.score - a.score);

      const top4 = scored.slice(0, 4).map(s => s.item);
      document.getElementById('aiMatchesHeading').textContent = `Top Individual Matches for ${state.aiGender} • ${state.aiStyle} (${state.aiOccasion})`;
      document.getElementById('aiMatchesGrid').innerHTML = top4.map(createProductCardHTML).join('');

      let title = 'Urban Utility Streetwear Combination';
      let sub = 'Oversized Hoodie + Cargo Pants • Heavyweight French terry paired with ripstop cargos';
      let ids = ['m-1', 'm-3'];

      if (state.aiGender === 'Men') {
        if (state.aiOccasion === 'Office' || state.aiOccasion === 'Wedding' || state.aiStyle === 'Classic' || state.aiStyle === 'Luxury') {
          title = 'Modern Executive Tailored Ensemble';
          sub = 'Formal Shirt + Pleated Trousers • Sharp architectural lines for elevated settings';
          ids = ['m-6', 'm-10'];
        } else if (state.aiStyle === 'Korean' || state.aiStyle === 'Oversized') {
          title = 'Seoul Street-Minimal Layered Set';
          sub = 'Oversized T-Shirt + Baggy Jeans • Effortless 90s drape with crisp silver contrast';
          ids = ['m-2', 'm-7'];
        } else if (state.aiOccasion === 'Travel') {
          title = 'First-Class Transit Athleisure Duo';
          sub = 'Crewneck Sweatshirt + Tapered Joggers • Plush 420 GSM fleece engineered for comfort';
          ids = ['m-5', 'm-13'];
        }
      } else if (state.aiGender === 'Women') {
        if (state.aiOccasion === 'Party' || state.aiOccasion === 'Wedding' || state.aiStyle === 'Luxury') {
          title = 'Evening Atelier Satin & Tweed Pairing';
          sub = 'Silk-Satin Midi Dress + Cropped Tweed Jacket • Luminous champagne-silver sophistication';
          ids = ['w-1', 'w-7'];
        } else {
          title = 'Off-Duty Editorial Denim & Knit Look';
          sub = 'Sculpt Crop Top + High-Waist Wide-Leg Jeans • Clean waist definition with fluid denim volume';
          ids = ['w-4', 'w-3'];
        }
      } else {
        title = 'All-Day Play Fleece & Denim Set';
        sub = 'Junior Fleece Hoodie + Flex-Waist Jeans • Soft organic cotton built for active days';
        ids = ['k-1', 'k-5'];
      }

      const outfitItems = ids.map(id => PRODUCTS.find(p => p.id === id)).filter(Boolean);
      window.__currentOutfitIds = ids;
      document.getElementById('aiOutfitTitle').textContent = title;
      document.getElementById('aiOutfitSubtitle').textContent = sub;
      document.getElementById('aiOutfitTotalPrice').textContent = formatINR(outfitItems.reduce((s, i) => s + i.price, 0));

      document.getElementById('aiOutfitPiecesGrid').innerHTML = outfitItems.map((item, idx) => `
        <div class="ai-piece-card" onclick="openQuickView('${item.id}')">
          <img src="${item.image}" alt="${item.name}" />
          <div>
            <span class="piece-tag">Piece 0${idx + 1} • ${item.category}</span>
            <h4>${item.name}</h4>
            <p class="muted-text">${item.description}</p>
            <div class="piece-bottom">
              <strong>${formatINR(item.price)}</strong>
              <button type="button" class="text-link" onclick="event.stopPropagation(); addToCart('${item.id}')">+ Add Piece</button>
            </div>
          </div>
        </div>
      `).join('');
    }

    window.selectCategory = function(cat) {
      state.category = cat;
      renderCategoryPills();
      renderCatalog();
    };

    window.addToCart = function(productId, size = null, color = null, qty = 1) {
      const p = PRODUCTS.find(x => x.id === productId);
      if (!p) return;
      const chosenSize = size || p.sizes[0];
      const chosenColor = color || p.colors[0].name;
      const existing = state.cart.find(i => i.id === p.id && i.size === chosenSize && i.color === chosenColor);
      if (existing) {
        existing.quantity += qty;
      } else {
        state.cart.push({ id: p.id, name: p.name, price: p.price, originalPrice: p.originalPrice, image: p.image, size: chosenSize, color: chosenColor, quantity: qty });
      }
      saveStorage();
      renderCartDrawer();
      showToast(`Added "${p.name}" (${chosenSize}) to your bag`);
    };

    window.toggleWishlist = function(productId) {
      const p = PRODUCTS.find(x => x.id === productId);
      if (!p) return;
      const idx = state.wishlist.indexOf(productId);
      if (idx > -1) {
        state.wishlist.splice(idx, 1);
        showToast(`Removed "${p.name}" from wishlist`);
      } else {
        state.wishlist.push(productId);
        showToast(`Saved "${p.name}" to wishlist`);
      }
      saveStorage();
      renderCatalog();
      renderStaticSections();
      renderAIStudio();
      renderWishlistDrawer();
    };

    window.openQuickView = function(productId) {
      const p = PRODUCTS.find(x => x.id === productId);
      if (!p) return;
      state.qvProduct = p;
      state.qvSize = p.sizes[0];
      state.qvColor = p.colors[0].name;
      state.qvQty = 1;

      document.getElementById('qvImage').src = p.image;
      document.getElementById('qvMeta').textContent = `${p.gender} • ${p.category}`;
      document.getElementById('qvTitle').textContent = p.name;
      document.getElementById('qvRating').textContent = `★ ${p.rating} (${p.reviews} verified reviews)`;
      document.getElementById('qvPrice').textContent = formatINR(p.price);
      document.getElementById('qvOrigPrice').textContent = formatINR(p.originalPrice);
      document.getElementById('qvDiscount').textContent = `Save ${formatINR(p.originalPrice - p.price)}`;
      document.getElementById('qvDesc').textContent = p.description;
      document.getElementById('qvQtyValue').textContent = '1';

      renderQvOptions();
      document.getElementById('quickViewModal').classList.remove('hidden');
    };

    function renderQvOptions() {
      const p = state.qvProduct;
      if (!p) return;
      document.getElementById('qvSelectedColorName').textContent = state.qvColor;
      document.getElementById('qvSelectedSizeName').textContent = state.qvSize;

      document.getElementById('qvColorsContainer').innerHTML = p.colors.map(c => `
        <button type="button" class="opt-pill ${state.qvColor === c.name ? 'active' : ''}" onclick="state.qvColor='${c.name}'; renderQvOptions()">
          <span class="swatch-dot" style="background:${c.hex}"></span> ${c.name}
        </button>
      `).join('');

      document.getElementById('qvSizesContainer').innerHTML = p.sizes.map(sz => `
        <button type="button" class="opt-pill ${state.qvSize === sz ? 'active' : ''}" onclick="state.qvSize='${sz}'; renderQvOptions()">${sz}</button>
      `).join('');
    }

    function renderCartDrawer() {
      const body = document.getElementById('cartItemsContainer');
      const footer = document.getElementById('cartFooter');
      if (state.cart.length === 0) {
        footer.classList.add('hidden');
        body.innerHTML = `<div class="empty-drawer"><h4>Your THREADORA bag is empty</h4><p>Explore our collections or try the AI Style Studio.</p></div>`;
        return;
      }
      footer.classList.remove('hidden');
      body.innerHTML = state.cart.map((item, idx) => `
        <div class="drawer-item">
          <img src="${item.image}" alt="${item.name}" />
          <div class="drawer-item-info">
            <div class="drawer-item-top">
              <strong>${item.name}</strong>
              <button type="button" onclick="removeCartItem(${idx})" class="icon-btn">🗑</button>
            </div>
            <span class="muted-sm">Size: ${item.size} • ${item.color}</span>
            <div class="drawer-item-bottom">
              <div class="qty-stepper sm">
                <button type="button" onclick="changeCartQty(${idx}, -1)">−</button>
                <span>${item.quantity}</span>
                <button type="button" onclick="changeCartQty(${idx}, 1)">+</button>
              </div>
              <strong>${formatINR(item.price * item.quantity)}</strong>
            </div>
          </div>
        </div>
      `).join('');

      const sub = state.cart.reduce((s, i) => s + i.price * i.quantity, 0);
      const orig = state.cart.reduce((s, i) => s + i.originalPrice * i.quantity, 0);
      const savings = orig - sub;
      const promo = state.promoApplied ? Math.round(sub * 0.1) : 0;
      const finalTotal = Math.max(0, sub - promo);

      document.getElementById('cartSubtotalVal').textContent = formatINR(sub);
      document.getElementById('cartSavingsVal').textContent = '− ' + formatINR(savings);
      document.getElementById('promoRow').classList.toggle('hidden', !state.promoApplied);
      document.getElementById('promoDiscountVal').textContent = '− ' + formatINR(promo);
      document.getElementById('cartFinalTotalVal').textContent = formatINR(finalTotal);
      document.getElementById('checkoutTotalDisplay').textContent = formatINR(finalTotal);
    }

    window.changeCartQty = function(idx, delta) {
      state.cart[idx].quantity += delta;
      if (state.cart[idx].quantity <= 0) state.cart.splice(idx, 1);
      saveStorage();
      renderCartDrawer();
    };

    window.removeCartItem = function(idx) {
      state.cart.splice(idx, 1);
      saveStorage();
      renderCartDrawer();
    };

    function renderWishlistDrawer() {
      const body = document.getElementById('wishlistItemsContainer');
      const items = PRODUCTS.filter(p => state.wishlist.includes(p.id));
      if (items.length === 0) {
        body.innerHTML = `<div class="empty-drawer"><h4>No saved items yet</h4><p>Tap the heart icon on any garment to save it here.</p></div>`;
        return;
      }
      body.innerHTML = items.map(item => `
        <div class="drawer-item">
          <img src="${item.image}" alt="${item.name}" />
          <div class="drawer-item-info">
            <strong>${item.name}</strong>
            <span class="muted-sm">${item.gender} • ${item.category}</span>
            <strong>${formatINR(item.price)}</strong>
            <div class="wish-actions">
              <button type="button" class="btn btn-dark-sm" onclick="addToCart('${item.id}'); document.getElementById('wishlistDrawerBackdrop').classList.add('hidden'); document.getElementById('cartDrawerBackdrop').classList.remove('hidden');">Move to Bag</button>
              <button type="button" class="text-btn" onclick="toggleWishlist('${item.id}')">Remove</button>
            </div>
          </div>
        </div>
      `).join('');
    }

    // Event Listeners Setup
    document.addEventListener('DOMContentLoaded', () => {
      updateBadges();
      renderCategoryPills();
      renderCatalog();
      renderStaticSections();
      renderAIStudio();
      renderCartDrawer();
      renderWishlistDrawer();

      // Gender Navigation & Tabs
      document.querySelectorAll('[data-gender]').forEach(el => {
        el.addEventListener('click', () => {
          const g = el.getAttribute('data-gender');
          if (!g) return;
          state.gender = g;
          state.category = 'All';
          state.ageGroup = 'All Ages';
          document.querySelectorAll('#genderTabs .tab-btn').forEach(b => b.classList.toggle('active', b.dataset.gender === g));
          document.getElementById('mobileMenuDrawer').classList.add('hidden');
          renderCategoryPills();
          renderCatalog();
        });
      });

      // Kids Age Pills
      document.querySelectorAll('.age-pill').forEach(btn => {
        btn.addEventListener('click', () => {
          state.ageGroup = btn.dataset.age;
          document.querySelectorAll('.age-pill').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          renderCatalog();
        });
      });

      // Filters & Sort
      document.getElementById('catalogSearchInput').addEventListener('input', e => { state.search = e.target.value; renderCatalog(); });
      document.getElementById('globalSearchInput').addEventListener('input', e => {
        state.search = e.target.value;
        document.getElementById('catalogSearchInput').value = e.target.value;
        renderCatalog();
      });
      document.getElementById('sizeFilter').addEventListener('change', e => { state.size = e.target.value; renderCatalog(); });
      document.getElementById('colorFilter').addEventListener('change', e => { state.color = e.target.value; renderCatalog(); });
      document.getElementById('maxPriceSlider').addEventListener('input', e => {
        state.maxPrice = Number(e.target.value);
        document.getElementById('maxPriceLabel').textContent = formatINR(state.maxPrice);
        renderCatalog();
      });
      document.getElementById('sortSelect').addEventListener('change', e => { state.sort = e.target.value; renderCatalog(); });

      document.querySelectorAll('.tag-chip').forEach(chip => {
        chip.addEventListener('click', () => {
          state.tag = chip.dataset.tag;
          document.querySelectorAll('.tag-chip').forEach(c => c.classList.remove('active'));
          chip.classList.add('active');
          renderCatalog();
        });
      });

      document.getElementById('resetFiltersBtn').addEventListener('click', () => {
        state.gender = 'All'; state.category = 'All'; state.ageGroup = 'All Ages';
        state.size = 'All'; state.color = 'All'; state.maxPrice = 11000;
        state.tag = 'All'; state.search = '';
        document.getElementById('catalogSearchInput').value = '';
        document.getElementById('sizeFilter').value = 'All';
        document.getElementById('colorFilter').value = 'All';
        document.getElementById('maxPriceSlider').value = 11000;
        document.getElementById('maxPriceLabel').textContent = '₹11,000';
        document.querySelectorAll('#genderTabs .tab-btn').forEach(b => b.classList.toggle('active', b.dataset.gender === 'All'));
        document.querySelectorAll('.tag-chip').forEach(c => c.classList.toggle('active', c.dataset.tag === 'All'));
        renderCategoryPills();
        renderCatalog();
      });

      // AI Studio Listeners
      document.querySelectorAll('.ai-g-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          state.aiGender = btn.dataset.gender;
          document.querySelectorAll('.ai-g-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          renderAIStudio();
        });
      });
      ['aiOccasion', 'aiStyle', 'aiCategory', 'aiBudget'].forEach(id => {
        document.getElementById(id).addEventListener('change', e => {
          state[id] = e.target.value;
          renderAIStudio();
        });
      });
      document.getElementById('addCompleteLookBtn').addEventListener('click', () => {
        (window.__currentOutfitIds || []).forEach(id => addToCart(id));
        showToast('Added Complete AI Curated Look to Bag!');
      });

      // Drawers & Modals Toggles
      document.getElementById('mobileMenuBtn').addEventListener('click', () => document.getElementById('mobileMenuDrawer').classList.toggle('hidden'));
      document.getElementById('searchToggleBtn').addEventListener('click', () => document.getElementById('searchBarDrawer').classList.toggle('hidden'));
      document.getElementById('closeSearchBtn').addEventListener('click', () => document.getElementById('searchBarDrawer').classList.add('hidden'));
      document.getElementById('clearSearchBtn').addEventListener('click', () => {
        state.search = '';
        document.getElementById('globalSearchInput').value = '';
        document.getElementById('catalogSearchInput').value = '';
        renderCatalog();
      });

      document.getElementById('cartOpenBtn').addEventListener('click', () => { renderCartDrawer(); document.getElementById('cartDrawerBackdrop').classList.remove('hidden'); });
      document.getElementById('footerOpenBag').addEventListener('click', () => { renderCartDrawer(); document.getElementById('cartDrawerBackdrop').classList.remove('hidden'); });
      document.getElementById('closeCartBtn').addEventListener('click', () => document.getElementById('cartDrawerBackdrop').classList.add('hidden'));

      document.getElementById('wishlistOpenBtn').addEventListener('click', () => { renderWishlistDrawer(); document.getElementById('wishlistDrawerBackdrop').classList.remove('hidden'); });
      document.getElementById('footerOpenWishlist').addEventListener('click', () => { renderWishlistDrawer(); document.getElementById('wishlistDrawerBackdrop').classList.remove('hidden'); });
      document.getElementById('closeWishlistBtn').addEventListener('click', () => document.getElementById('wishlistDrawerBackdrop').classList.add('hidden'));

      // Quick View Controls
      document.getElementById('closeQvBtn').addEventListener('click', () => document.getElementById('quickViewModal').classList.add('hidden'));
      document.getElementById('qvMinusBtn').addEventListener('click', () => {
        state.qvQty = Math.max(1, state.qvQty - 1);
        document.getElementById('qvQtyValue').textContent = state.qvQty;
      });
      document.getElementById('qvPlusBtn').addEventListener('click', () => {
        state.qvQty += 1;
        document.getElementById('qvQtyValue').textContent = state.qvQty;
      });
      document.getElementById('qvAddToBagBtn').addEventListener('click', () => {
        if (state.qvProduct) {
          addToCart(state.qvProduct.id, state.qvSize, state.qvColor, state.qvQty);
          document.getElementById('quickViewModal').classList.add('hidden');
        }
      });
      document.getElementById('qvWishlistBtn').addEventListener('click', () => {
        if (state.qvProduct) toggleWishlist(state.qvProduct.id);
      });

      // Promo & Demo Checkout
      document.getElementById('applyPromoBtn').addEventListener('click', () => {
        const val = document.getElementById('promoInput').value.trim().toUpperCase();
        if (val === 'THREADORA10') {
          state.promoApplied = true;
          renderCartDrawer();
          showToast('Applied 10% THREADORA10 privilege!');
        } else {
          showToast('Enter code THREADORA10 for 10% off');
        }
      });

      document.getElementById('openCheckoutBtn').addEventListener('click', () => {
        document.getElementById('cartDrawerBackdrop').classList.add('hidden');
        document.getElementById('checkoutFormView').classList.remove('hidden');
        document.getElementById('checkoutSuccessView').classList.add('hidden');
        document.getElementById('checkoutModal').classList.remove('hidden');
      });
      document.getElementById('closeCheckoutBtn').addEventListener('click', () => document.getElementById('checkoutModal').classList.add('hidden'));
      document.getElementById('finishCheckoutBtn').addEventListener('click', () => document.getElementById('checkoutModal').classList.add('hidden'));

      document.querySelectorAll('.pm-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.pm-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
        });
      });

      document.getElementById('demoCheckoutForm').addEventListener('submit', e => {
        e.preventDefault();
        const name = document.getElementById('chkName').value || 'Valued Guest';
        const orderId = 'THR-' + Math.floor(100000 + Math.random() * 900000);
        const count = state.cart.reduce((s, i) => s + i.quantity, 0);
        const total = document.getElementById('checkoutTotalDisplay').textContent;

        document.getElementById('orderIdText').textContent = `ORDER CONFIRMED • ${orderId}`;
        document.getElementById('thankYouTitle').textContent = `Thank You, ${name}`;
        document.getElementById('orderSummaryMsg').textContent = `Your THREADORA order of ${count} item(s) totaling ${total} has been scheduled for express dispatch.`;

        state.cart = [];
        state.promoApplied = false;
        saveStorage();
        renderCartDrawer();

        document.getElementById('checkoutFormView').classList.add('hidden');
        document.getElementById('checkoutSuccessView').classList.remove('hidden');
      });

      // Newsletter & Contact
      document.getElementById('newsletterForm').addEventListener('submit', e => {
        e.preventDefault();
        document.getElementById('newsletterForm').classList.add('hidden');
        document.getElementById('newsletterFeedback').classList.remove('hidden');
      });
      document.getElementById('contactForm').addEventListener('submit', e => {
        e.preventDefault();
        document.getElementById('contactForm').classList.add('hidden');
        document.getElementById('contactFeedback').classList.remove('hidden');
      });
    });
  </script>
</body>
</html>
